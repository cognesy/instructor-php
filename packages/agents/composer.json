{
  "name": "cognesy/agents",
  "description": "SDK for building custom AI agents",
  "license": "MIT",
  "homepage": "https://instructorphp.com",
  "support": {
    "issues": "https://github.com/cognesy/instructor-php/issues",
    "source": "https://github.com/cognesy/instructor-php"
  },
  "authors": [
    {
      "name": "Dariusz Debowczyk",
      "email": "ddebowczyk@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Cognesy\\Agents\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cognesy\\Agents\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "composer-runtime-api": "^2.0",
    "cognesy/instructor-contracts": "^2.6",
    "cognesy/instructor-metrics": "^2.6",
    "ext-fileinfo": "*",
    "ext-libxml": "*",
    "cognesy/instructor-dynamic": "^2.6",
    "cognesy/instructor-events": "^2.6",
    "cognesy/instructor-http-client": "^2.6",
    "cognesy/logging": "^2.3",
    "cognesy/instructor-messages": "^2.6",
    "cognesy/instructor-polyglot": "^2.6",
    "cognesy/instructor-sandbox": "^2.6",
    "cognesy/instructor-schema": "^2.6",
    "cognesy/instructor-struct": "^2.6",
    "cognesy/instructor-telemetry": "^2.6",
    "cognesy/instructor-utils": "^2.6",
    "cognesy/xprompt-php": "^2.6",
    "symfony/yaml": "^7.0 || ^8.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "mockery/mockery": "^1.6",
    "icanhazstring/composer-unused": "^0.9.0",
    "jetbrains/phpstorm-attributes": "^1.2",
    "maglnet/composer-require-checker": "^4.16",
    "pestphp/pest": "^2.34",
    "phpstan/phpstan": "^1.11",
    "vimeo/psalm": "^6.0"
  },
  "scripts": {
    "docs:self-knowledge:check": "@php scripts/sync-self-knowledge-docs.php --check",
    "docs:self-knowledge:write": "@php scripts/sync-self-knowledge-docs.php --write",
    "tests": "@php ../../vendor/bin/pest --configuration=phpunit.xml --bootstrap=../../vendor/autoload.php tests",
    "phpstan": "@php ../../vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=2G",
    "psalm": "@php ../../vendor/bin/psalm --root=../.. --config=psalm.xml",
    "pint": "@php ../../vendor/bin/pint --config pint.json src/",
    "pint:test": "@php ../../vendor/bin/pint --config pint.json src/ --test",
    "qa:docs": "bash ../../scripts/docs/docs-qa-all.sh agents",
    "qa": [
      "@tests",
      "@phpstan",
      "@psalm",
      "@pint:test",
      "@qa:docs",
      "@docs:self-knowledge:check"
    ]
  },
  "bin": [
    "bin/agents-eval"
  ],
  "suggest": {
    "pestphp/pest": "Use PestEvalReporter to make eval runs fail Pest tests",
    "phpunit/phpunit": "Use PHPUnitEvalReporter to make eval runs fail PHPUnit tests"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "RC",
  "prefer-stable": true
}
