{
  "name": "cognesy/instructor-struct",
  "license": "MIT",
  "description": "Structured data extraction in PHP, powered by LLMs - core library",
  "keywords": [
    "llm",
    "language models",
    "inference",
    "ai",
    "genai",
    "openai",
    "anthropic",
    "cohere",
    "ollama",
    "structured output",
    "semantic processing",
    "automation",
    "data processing",
    "data extraction"
  ],
  "type": "library",
  "homepage": "https://instructorphp.com",
  "support": {
    "issues": "https://github.com/cognesy/instructor-php/issues",
    "source": "https://github.com/cognesy/instructor-php"
  },
  "authors": [
    {
      "name": "Dariusz Debowczyk",
      "email": "ddebowczyk@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Cognesy\\Instructor\\": "src/"
    },
    "files": []
  },
  "autoload-dev": {
    "psr-4": {
      "Cognesy\\Instructor\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "cognesy/instructor-contracts": "^2.9",
    "cognesy/instructor-http-client": "^2.9",
    "cognesy/instructor-schema": "^2.9",
    "cognesy/instructor-stream": "^2.9",
    "cognesy/xprompt": "^2.8",
    "cognesy/instructor-config": "^2.9",
    "cognesy/instructor-events": "^2.9",
    "cognesy/logging": "^2.3",
    "cognesy/instructor-messages": "^2.9",
    "cognesy/instructor-pipeline": "^2.9",
    "cognesy/instructor-polyglot": "^2.9",
    "cognesy/instructor-setup": "^2.9",
    "cognesy/instructor-telemetry": "^2.9",
    "cognesy/instructor-templates": "^2.9",
    "cognesy/instructor-utils": "^2.9",
    "psr/event-dispatcher": "^1.0",
    "psr/log": "^3.0",
    "symfony/property-access": "^7.3 || ^8.0",
    "symfony/property-info": "^7.3 || ^8.0",
    "symfony/serializer": "^7.3 || ^8.0",
    "symfony/validator": "^7.3 || ^8.0",
    "twig/twig": "^3.0"
  },
  "require-dev": {
    "cognesy/instructor-dynamic": "^2.9",
    "icanhazstring/composer-unused": "^0.9.0",
    "jetbrains/phpstorm-attributes": "^1.2",
    "maglnet/composer-require-checker": "^4.16",
    "mockery/mockery": "^1.6",
    "pestphp/pest": "^4.0",
    "phpstan/phpstan": "^1.11",
    "roave/security-advisories": "dev-latest",
    "vimeo/psalm": "^6.0"
  },
  "scripts": {
    "test": "@tests",
    "tests": "@php vendor/bin/pest",
    "phpstan": "@php ../../vendor/bin/phpstan analyse -c phpstan.neon",
    "psalm": "@php vendor/bin/psalm"
  },
  "minimum-stability": "RC",
  "prefer-stable": true
}
