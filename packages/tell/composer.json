{
  "name": "cognesy/instructor-tell",
  "description": "AXI-oriented CLI for running and inspecting Instructor agents",
  "license": "MIT",
  "homepage": "https://instructorphp.com",
  "support": {
    "issues": "https://github.com/cognesy/instructor-php/issues",
    "source": "https://github.com/cognesy/instructor-php"
  },
  "authors": [
    {
      "name": "Dariusz Debowczyk",
      "email": "ddebowczyk@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Cognesy\\Tell\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cognesy\\Tell\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "cognesy/agents": "^2.8",
    "cognesy/instructor-config": "^2.8",
    "cognesy/instructor-polyglot": "^2.8",
    "composer-runtime-api": "^2.0",
    "helgesverre/toon": "^3.2",
    "symfony/console": "^7.3 || ^8.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "icanhazstring/composer-unused": "^0.9.0",
    "jetbrains/phpstorm-attributes": "^1.2",
    "maglnet/composer-require-checker": "^4.16",
    "pestphp/pest": "^2.34",
    "phpstan/phpstan": "^1.11",
    "vimeo/psalm": "^6.0"
  },
  "scripts": {
    "tests": "@php vendor/bin/pest",
    "phpstan": "@php vendor/bin/phpstan -c phpstan.neon",
    "psalm": "@php vendor/bin/psalm",
    "tell": "@php bin/tell"
  },
  "bin": [
    "bin/tell"
  ],
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "RC",
  "prefer-stable": true
}
