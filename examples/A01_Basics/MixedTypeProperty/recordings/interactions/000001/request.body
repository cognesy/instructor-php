{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Tool Use\n\nUse the provided tool `extracted_data` to extract correct and accurate structured data from the input.\n\nTool purpose: Function call based on user instructions.\n\nCall the tool with the best supported arguments for the requested extraction."},{"role":"user","content":"Jason is 25 years old. He plays football and loves to travel."}],"max_completion_tokens":1024,"tools":[{"type":"function","function":{"name":"extracted_data","description":"Function call based on user instructions.","parameters":{"type":"object","description":"Person profile extracted from a short biographical sentence","properties":{"name":{"type":"string","description":"Actual person name from the source text\nFor the example text, extract Jason exactly."},"extraInfo":{"description":"Flexible additional facts about the user, such as age, hobbies, interests, or travel preferences\nKeep extraInfo as null only when no additional facts are present; otherwise use a compact JSON object or array.","nullable":true,"default":null}},"required":["name"],"additionalProperties":false}}}],"tool_choice":{"type":"function","function":{"name":"extracted_data"}},"reasoning_effort":"none"}