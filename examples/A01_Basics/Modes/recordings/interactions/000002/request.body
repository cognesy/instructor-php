{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Output Requirements\n\nRespond with a strict JSON object that follows the provided JSON Schema.\n\nSchema name: `User`\n\n{\n    \"type\": \"object\",\n    \"x-title\": \"User\",\n    \"properties\": {\n        \"age\": {\n            \"type\": \"integer\"\n        },\n        \"name\": {\n            \"type\": \"string\"\n        }\n    },\n    \"required\": [\n        \"age\",\n        \"name\"\n    ],\n    \"x-php-class\": \"User\",\n    \"additionalProperties\": false\n}"},{"role":"user","content":"Jason is 25 years old and works as an engineer."}],"max_completion_tokens":1024,"response_format":{"type":"json_schema","json_schema":{"name":"User","schema":{"type":"object","properties":{"age":{"type":"integer"},"name":{"type":"string"}},"required":["age","name"],"additionalProperties":false},"strict":true}}}