{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Output Requirements\n\nRespond with a strict JSON object that matches this JSON Schema:\n\n{\n    \"type\": \"object\",\n    \"x-title\": \"collectionOfEducation\",\n    \"description\": \"A collection of Education\",\n    \"properties\": {\n        \"list\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"x-title\": \"Education\",\n                \"properties\": {\n                    \"degree\": {\n                        \"type\": \"string\",\n                        \"enum\": [\n                            \"Bachelors\",\n                            \"Masters\",\n                            \"PhD\"\n                        ],\n                        \"x-php-class\": \"Degree\"\n                    },\n                    \"school\": {\n                        \"type\": \"string\"\n                    },\n                    \"topic\": {\n                        \"type\": \"string\"\n                    },\n                    \"year\": {\n                        \"type\": \"integer\",\n                        \"nullable\": true,\n                        \"default\": null\n                    }\n                },\n                \"required\": [\n                    \"degree\",\n                    \"school\",\n                    \"topic\"\n                ],\n                \"x-php-class\": \"Education\",\n                \"additionalProperties\": false\n            }\n        }\n    },\n    \"required\": [\n        \"list\"\n    ],\n    \"x-php-class\": \"Cognesy\\\\Instructor\\\\Extras\\\\Sequence\\\\Sequence\",\n    \"additionalProperties\": false\n}"},{"role":"user","content":"Which schools did Estella Leopold attend in her education?"}],"max_completion_tokens":1024,"response_format":{"type":"json_object"}}