{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Tool Use\n\nUse the provided tool `extracted_data` to extract correct and accurate structured data from the input.\n\nTool purpose: Function call based on user instructions.\n\nCall the tool with the best supported arguments for the requested extraction."},{"role":"user","content":"Jane Doe lives in Springfield, 50210. She is 25 years old and works as manager at McDonald's.\nMcDonald's in New York is located at 456 Elm St, NYC, 12345. Her favourite books are \"The Lord\nof the Rings\" and \"The Hobbit\" by JRR Tolkien."}],"max_completion_tokens":1024,"tools":[{"type":"function","function":{"name":"extracted_data","description":"Function call based on user instructions.","parameters":{"type":"object","description":"A person object","properties":{"name":{"type":"string","description":"Name of the person"},"age":{"type":"integer","description":"Age of the person"},"gender":{"type":"string","description":"Gender of the person","enum":["male","female"]},"address":{"type":"object","description":"Address of the person","properties":{"street":{"type":"string","description":"Street name"},"city":{"type":"string","description":"City name"},"zip":{"type":"string","description":"Zip code"}},"required":["city"],"additionalProperties":false},"role":{"type":"string","description":"Role of the person","enum":["manager","line"]},"favourite_books":{"type":"array","items":{"type":"object","description":"Favorite book data","properties":{"author":{"type":"string","description":"Book author"},"title":{"type":"string","description":"Book title"}},"required":["title"],"additionalProperties":false},"description":"Favorite books of the person"}},"required":["name","age","address","role","favourite_books"],"additionalProperties":false}}}],"tool_choice":{"type":"function","function":{"name":"extracted_data"}},"reasoning_effort":"none"}