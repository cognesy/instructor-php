{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Output Requirements\n\nRespond with a strict JSON object that follows the provided JSON Schema.\n\nSchema name: `city`\n\n{\n    \"type\": \"object\",\n    \"x-title\": \"city\",\n    \"properties\": {\n        \"name\": {\n            \"type\": \"string\",\n            \"description\": \"City name\"\n        },\n        \"population\": {\n            \"type\": \"integer\",\n            \"description\": \"City population\"\n        },\n        \"founded\": {\n            \"type\": \"integer\",\n            \"description\": \"Founding year\"\n        }\n    },\n    \"required\": [\n        \"name\",\n        \"population\",\n        \"founded\"\n    ],\n    \"x-php-class\": \"stdClass\",\n    \"additionalProperties\": false\n}"},{"role":"user","content":"What is capital of France? \\\n        Respond with JSON data."}],"max_completion_tokens":1024,"response_format":{"type":"json_schema","json_schema":{"name":"city","schema":{"type":"object","properties":{"name":{"type":"string","description":"City name"},"population":{"type":"integer","description":"City population"},"founded":{"type":"integer","description":"Founding year"}},"required":["name","population","founded"],"additionalProperties":false},"strict":true}}}