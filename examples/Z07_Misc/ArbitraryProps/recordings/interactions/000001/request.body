{"model":"gpt-6-luna","messages":[{"role":"system","content":"## Output Requirements\n\nRespond with a strict JSON object that matches this JSON Schema:\n\n{\n    \"type\": \"object\",\n    \"x-title\": \"UserDetail\",\n    \"properties\": {\n        \"age\": {\n            \"type\": \"integer\"\n        },\n        \"name\": {\n            \"type\": \"string\"\n        },\n        \"properties\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"x-title\": \"item\",\n                \"description\": \"Correctly extract items of type: Property\",\n                \"properties\": {\n                    \"key\": {\n                        \"type\": \"string\"\n                    },\n                    \"value\": {\n                        \"type\": \"string\"\n                    }\n                },\n                \"required\": [\n                    \"key\",\n                    \"value\"\n                ],\n                \"x-php-class\": \"\\\\Property\",\n                \"additionalProperties\": false\n            }\n        }\n    },\n    \"required\": [\n        \"age\",\n        \"name\",\n        \"properties\"\n    ],\n    \"x-php-class\": \"UserDetail\",\n    \"additionalProperties\": false\n}"},{"role":"user","content":"Jason is 25 years old. He is a programmer. He has a car. He lives\nin a small house in Alamo. He likes to play guitar."}],"max_completion_tokens":1024,"response_format":{"type":"json_object"}}